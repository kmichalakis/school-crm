DATABASE_URL="postgresql://school_crm:school_crm@localhost:5432/school_crm?schema=public"
# Προαιρετικό: pooled URL για Prisma Postgres στο runtime (όχι για migrations).
# Στο Vercel μπορεί να παρέχεται ήδη ως DATABASE_URL_POOLED από την ενσωμάτωση Prisma.
DATABASE_POOL_URL=""
NEXTAUTH_SECRET="change-this-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"
EMAIL_FROM="attendance@example.com"
